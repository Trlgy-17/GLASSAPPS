# ==============================================================================
# PUTRA GLASS APPS - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Jangan masukkan nilai rahasia/kredensial ke file ini.
# Salin file ini menjadi .env.local dan isi nilai kredensial di sana.
# ==============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Jalur DNS cadangan ke Supabase (scripts/patch-dns.js).
# Otomatis aktif di komputer lokal, otomatis mati di server produksi.
# Isi 0 untuk mematikan di lokal. JANGAN isi 1 di VPS.
SUPABASE_DNS_PATCH=
SUPABASE_DNS_PATCH_IP=

# Akun Pengujian & E2E (Owner & Admin)
TEST_OWNER_EMAIL=
TEST_OWNER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Google Gemini AI
GEMINI_API_KEY=
GEMINI_PRO_ENABLED=
NEXT_PUBLIC_GEMINI_PRO_ENABLED=
GEMINI_MODEL_FAST=
GEMINI_MODEL_MAIN=
GEMINI_MODEL_PRO=
GEMINI_MODEL_FALLBACK=
GEMINI_DRAFT_MODELS=
AI_DRAFT_CHAIN=
AI_MAX_REQUESTS_PER_DAY=
